# Fury environment example.
# Copy to .env (gitignored) for local dev, or set these as real
# environment variables where the release tooling runs.
# NEVER ship real secrets to client/launcher machines, and never commit
# account identifiers or credentials to this repository.

# ===============================================================
# Cosmetic Search (desktop loopback service; standalone bind opt-in)
# ===============================================================

COSMETIC_SEARCH_PORT=3210
# Standalone server opt-in only. Launcher-owned services always stay loopback.
# COSMETIC_SEARCH_BIND_HOST=0.0.0.0
# Optional local/standalone API access token; desktop callers use loopback.
COSMETIC_SEARCH_TOKEN=
COSMETIC_SEARCH_CACHE_TTL_MS=
COSMETIC_SEARCH_MAX_LIMIT=

# ===============================================================
# Aurora cosmetic resource (optional)
# ===============================================================

AURORA_API_KEY=
AURORA_COSMETIC_RESOURCE=

# ===============================================================
# Release publishing (maintainer machine only)
# ===============================================================

# Cloudflare account the download tracker, R2 bucket and Pages project live in.
# wrangler.json deliberately carries no account identifier; these stay here.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===============================================================
# Development helpers
# ===============================================================

# Comma-separated launcher accounts pinned to the top of the development
# sign-in list. Ignored entirely in packaged builds. Defaults to Nestersen.
FURY_DEV_PINNED_ACCOUNTS=

# ===============================================================
# Misc
# ===============================================================

# Override the Node binary used by child processes (rare).
NODE_BINARY=

# Compatibility/debug overrides. Leave both off for best performance.
# Use software rendering only if a specific GPU driver breaks the launcher.
FURY_DISABLE_HARDWARE_ACCELERATION=0
# Verbose custom-payload decoding is expensive and intended for diagnostics.
FURY_PACKET_DEBUG=0
